{
	// THEME
	"agent_servers": {
		"opencode": {
			"type": "registry",
			"default_config_options": {
				"effort": "high",
				"model": "openai/gpt-5.4",
			},
		},
	},
	"collaboration_panel": {
		"dock": "left",
	},
	"outline_panel": {
		"dock": "left",
		"button": false,
	},
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always",
					},
				},
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always",
					},
				},
			},
			"enable_lsp_tasks": true,
		},
	},
	"icon_theme": "Warm Charmed Icons",
	"theme": "Aura Dark",

	"theme_overrides": {
		"Aura Dark": {
			"editor.document_highlight.read_background": "#00000000",
			"editor.document_highlight.write_background": "#00000000",

			"border.variant": "#15141C",
			"border": "#15141C",
			"title_bar.background": "#15141C",
			"panel.background": "#15141C",
			"panel.focused_border": "#4E466E",
			"players": [{ "cursor": "#BD9DFF" }],
			"syntax": {
				"comment": { "font_style": "italic" },
				"comment.doc": { "font_style": "italic" },
			},
		},
	},

	// UI STRIPPING (Monk Mode)

	"tab_bar": { "show": true },
	"tabs": {
		"file_icons": true,
		"git_status": true,
		"show_diagnostics": "all",
	},

	"toolbar": { "quick_actions": true },
	// "status_bar": { "experimental.show": false },

	"scrollbar": { "show": "never" },

	"gutter": {
		"min_line_number_digits": 0,
		"folds": false,
		"runnables": false,
	},

	"indent_guides": {
		"enabled": false,
		"coloring": "indent_aware",
	},

	"relative_line_numbers": "enabled",
	"current_line_highlight": "none",
	"selection_highlight": false,
	"show_whitespaces": "none",

	"centered_layout": {
		"left_padding": 0.15,
		"right_padding": 0.15,
	},

	// FONTS
	"ui_font_family": "JetBrains Mono",
	"buffer_font_family": "JetBrains Mono",
	"terminal": {
		"toolbar": { "breadcrumbs": true },
		"line_height": "standard",
		"font_family": "JetBrains Mono",
		"env": { "EDITOR": "zed --wait" },
	},

	"ui_font_size": 20,
	"agent_ui_font_size": 20,
	"buffer_font_size": 20,
	"buffer_font_weight": 450.0,
	"buffer_line_height": { "custom": 2 },
	"agent_buffer_font_size": 20,

	// BEHAVIOR
	"vim_mode": true,
	"base_keymap": "VSCode",
	"multi_cursor_modifier": "cmd_or_ctrl",
	// "cursor_shape": "block",
	"cursor_blink": false,

	"auto_indent": "none",
	"auto_indent_on_paste": true,
	"show_completions_on_input": true,
	"show_completion_documentation": true,
	"hover_popover_enabled": true,

	"format_on_save": "on",

	"autosave": {
		"after_delay": { "milliseconds": 1000 },
	},

	"extend_comment_on_newline": false,

	// PROJECT PANEL

	"project_panel": {
		"dock": "right",
		"default_width": 400,
		"hide_root": true,
		"auto_fold_dirs": false,
		"starts_open": false,
		"git_status": true,
		"sticky_scroll": false,
		"scrollbar": { "show": "never" },
		"indent_guides": { "show": "never" },
	},

	"git_panel": { "dock": "right" },

	// AGENT CONFIG

	"agent": {
		"inline_assistant_model": {
			"provider": "copilot_chat",
			"model": "gpt-5.2-codex",
			"enable_thinking": false,
		},
		"default_profile": "write",
		"button": false,
		"dock": "left",
		"default_model": {
			"effort": "high",
			"provider": "zed.dev",
			"model": "claude-sonnet-4-6",
			"enable_thinking": true,
		},
		"favorite_models": [
   {
    "provider": "copilot_chat",
    "model": "gpt-5.3-codex",
    "enable_thinking": false
   },
   {
    "provider": "copilot_chat",
    "model": "grok-code-fast-1",
    "enable_thinking": false
   },
   {
    "provider": "copilot_chat",
    "model": "gpt-5.2-codex",
    "enable_thinking": false
   },
   {
    "provider": "copilot_chat",
    "model": "gpt-5.1",
    "enable_thinking": false
   },
   {
    "provider": "zed.dev",
    "model": "claude-sonnet-4-6",
    "enable_thinking": true,
    "effort": "high"
   },
   {
    "provider": "zed.dev",
    "model": "claude-sonnet-4-5",
    "enable_thinking": true
   }
  ],
		"model_parameters": [],
	},

	// DIAGNOSTICS

	"diagnostics": {
		"button": true,
		"include_warnings": true,
		"lsp_pull_diagnostics": {
			"enabled": true,
			"debounce_ms": 50,
		},
		"inline": {
			"enabled": true,
			"update_debounce_ms": 150,
			"padding": 4,
			"min_column": 0,
			"max_severity": null,
		},
	},

	// GIT

	"git": {
		"git_gutter": "hide",
		"inline_blame": { "enabled": false },
	},

	// TELEMETRY

	"telemetry": { "diagnostics": false },

	// FILE TYPES

	"file_types": {
		"Dockerfile": ["Dockerfile", "Dockerfile.*"],
		"JSON": ["json", "jsonc", "*.code-snippets"],
	},

	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/.vscode",
		"**/.idea",
		"**/node_modules",
		"**/.serverless",
		"**/build",
		"**/dist",
		"**/coverage",
		"**/.venv",
		"**/__pycache__",
		"**/.ropeproject",
		"**/.pytest_cache",
		"**/.ruff_cache",
	],

	"file_scan_inclusions": [".env"],

	// GLOBAL INDENT

	"tab_size": 2,
	"preferred_line_length": 120,
	"hard_tabs": true,

	// LANGUAGE FORMATTERS

	"languages": {
		"Python": {
			"tab_size": 4,
			"hard_tabs": false,
			"auto_indent": "syntax_aware",
			"format_on_save": "on",
			"formatter": "language_server",
		},
		"CSS": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--parser=css", "--single-quote"],
				},
			},
		},

		"HTML": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": ["--parser=html", "--single-quote", "--bracket-same-line"],
				},
			},
		},

		// "JavaScript": {
		// 	"formatter": {
		// 		"external": {
		// 			"command": "pnpm",
		// 			"arguments": ["exec", "prettier", "--stdin-filepath", "{buffer_path}"],
		// 		},
		// 	},
		// 	"code_actions_on_format": {
		// 		"source.fixAll.eslint": true,
		// 	},
		// 	"format_on_save": "on",
		// },

		// "TypeScript": {
		// 	"formatter": {
		// 		"external": {
		// 			"command": "pnpm",
		// 			"arguments": ["exec", "prettier", "--stdin-filepath", "{buffer_path}"],
		// 		},
		// 	},
		// 	"code_actions_on_format": {
		// 		"source.fixAll.eslint": true,
		// 	},
		// 	"format_on_save": "on",
		// },

		// "TSX": {
		// 	"formatter": {
		// 		"external": {
		// 			"command": "pnpm",
		// 			"arguments": ["exec", "prettier", "--stdin-filepath", "{buffer_path}"],
		// 		},
		// 	},
		// 	"code_actions_on_format": {
		// 		"source.fixAll.eslint": true,
		// 		"source.removeUnusedImports": true,
		// 	},
		// 	"format_on_save": "on",
		// },

		"JavaScript": {
			"formatter": "language_server",
			"format_on_save": "on",
		},
		"TypeScript": {
			"formatter": "language_server",
			"format_on_save": "on",
		},
		"TSX": {
			"formatter": "language_server",
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.removeUnusedImports": true,
			},
		},
	},
	"inlay_hints": {
		"enabled": false,
	},

	"show_edit_predictions": false,
	"edit_predictions": {
		"disabled_globs": [
			"**/.git",
			"**/.svn",
			"**/.hg",
			"**/CVS",
			"**/.DS_Store",
			"**/Thumbs.db",
			"**/.classpath",
			"**/.settings",
			"**/.vscode",
			"**/.idea",
			"**/node_modules",
			"**/.serverless",
			"**/build",
			"**/dist",
			"**/coverage",
			"**/.venv",
			"**/__pycache__",
			"**/.ropeproject",
			"**/.pytest_cache",
			"**/.ruff_cache",
		],
		"copilot": {
			"proxy": null,
			"proxy_no_verify": null,
		},
	},
}

